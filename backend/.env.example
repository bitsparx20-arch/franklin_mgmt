MONGO_URL=mongodb://localhost:27017
DB_NAME=franklin_crm
JWT_SECRET=change-me-in-production
ADMIN_EMAIL=ceo@franklinwardcorpp.com
ADMIN_PASSWORD=ceo12345
# --- Franklin-AI (pick one provider) ---
LLM_PROVIDER=bedrock

# AWS Bedrock (recommended)
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-20250514-v1:0
# Long-term key from Bedrock console → API keys (preferred)
BEDROCK_API_KEY=
# Or IAM access keys instead of BEDROCK_API_KEY:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_MAX_TOKENS=2048
# BEDROCK_TEMPERATURE=0.3

# Emergent (legacy alternative)
# LLM_PROVIDER=emergent
# EMERGENT_LLM_KEY=your-key-for-ai-chat

# SpringEdge SMS + WhatsApp (PinBot) — see WhatsApp_API_Pinned_Documentation.pdf
SPRINGEDGE_API_KEY=
SPRINGEDGE_SENDER_ID=SPREDG
SPRINGEDGE_API_STYLE=legacy
SPRINGEDGE_LEGACY_SMS_URL=https://web.springedge.com/api/web/send
# WhatsApp Business API (PinBot v3 — partnersv1.pinbot.ai)
SPRINGEDGE_WABA_API_KEY=
SPRINGEDGE_PHONE_NUMBER_ID=
# SPRINGEDGE_WHATSAPP_API_URL=https://partnersv1.pinbot.ai/v3
# SPRINGEDGE_WHATSAPP_TEMPLATE=your_approved_template_name
# SPRINGEDGE_MOCK=true
